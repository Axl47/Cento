{
  "name": "cento",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "export": "tsx --env-file=.env src/cli/export.ts",
    "eval": "tsx --env-file=.env src/cli/eval.ts",
    "backfill": "tsx --env-file=.env src/cli/backfill.ts",
    "merge-copies": "tsx --env-file=.env src/cli/dedupe.ts",
    "typecheck": "tsc --noEmit",
    "audio": "tsx --env-file=.env src/cli/audio.ts",
    "edges": "tsx --env-file=.env src/cli/edges.ts",
    "classify": "tsx --env-file=.env src/cli/classify.ts",
    "lyrics": "tsx --env-file=.env src/cli/lyrics.ts",
    "host": "tsx src/cli/host.ts",
    "host:stop": "tsx src/cli/host.ts --stop",
    "host:serve": "tsx --env-file=.env src/host/server.ts",
    "test": "tsx --test src/**/*.test.ts",
    "features": "tsx --env-file=.env src/cli/features.ts",
    "tags": "tsx --env-file=.env src/cli/tags.ts",
    "plays": "tsx src/cli/plays.ts",
    "eras": "tsx src/cli/eras.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "umap-js": "^1.4.0",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  }
}
